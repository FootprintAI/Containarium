[Unit]
Description=SSHPiper anonymous-box door (ssh new.<domain>, #2198)
After=network.target
# Same reasoning as sshpiper.service: never let the start-rate limiter give
# up on the door listener.
StartLimitIntervalSec=0

[Service]
# The door plugin signs its daemon calls with the sentinel's own identity
# (CONTAINARIUM_SENTINEL_AUTH_SECRET / _SIGNING_KEY) — no second secret.
EnvironmentFile=-/etc/containarium/env.secrets
ExecStart=/usr/local/bin/sshpiperd \
  -i /etc/sshpiper/host_key \
  -l ${anon_listen_host} \
  -p ${anon_listen_port} \
  --drop-hostkeys-message \
  /usr/local/bin/containarium sentinel ssh-session-plugin \
  --records-file /var/log/containarium/ssh-sessions.jsonl \
  --sshpiper-config /etc/sshpiper/config.yaml \
  -- \
  /usr/local/bin/containariumd sentinel ssh-upstream-plugin \
  --listener anonymous \
  --upstream-control-socket /run/containarium/ssh-upstream/control.sock \
  --plugin /usr/local/bin/containariumd \
  --plugin-arg=sentinel \
  --plugin-arg=anon-door-plugin \
  --plugin-arg=--daemon-url \
  --plugin-arg=${anon_daemon_url} \
  --plugin-arg=--upstream-control-socket \
  --plugin-arg=/run/containarium/ssh-upstream/control.sock \
  -- \
  /usr/local/bin/containariumd sentinel ssh-ban-plugin \
  --listener anonymous \
  --upstream-control-socket /run/containarium/ssh-upstream/control.sock \
  --max-failures ${ssh_ban_max_failures} \
%{ for prefix in ssh_ban_ignore_cidrs ~}
  --ignore-ip ${prefix} \
%{ endfor ~}
  --ban-duration ${ssh_ban_duration_seconds}s
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
