# Binaries and build artifacts
bin/
dist/
*.exe
*.dll
*.so
*.dylib
*.test
*.out

# Root-level build output from `go build ./cmd/<name>` run with no -o flag
# (lands at the repo root, named after the package) — none of the patterns
# above catch an extensionless binary sitting there. Anchored to the root
# (leading /) so this can never shadow a same-named path in a subdirectory.
# Caught in PR review after one shipped in a PR diff (35MB ELF, 0/0 diff
# lines — GitHub can't diff a binary, which is the tell).
/agent-box
/containarium
/containariumd
/ebpf-phase0
/ebpf-phaseA
/mcp-server
/model-gateway
/netpolicy-smoke

# Go workspace file
go.work
go.work.sum

# IDE and editor files
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Terraform files
*.tfstate
*.tfstate.*
*.tfstate.backup
.terraform/
.terraform.lock.hcl
*.tfvars
!*.tfvars.example
crash.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Backend configuration (use backend-*.tf.example templates)
backend.tf

# Environment-specific configs (use environments/*.tfvars.example templates)
environments/*.tfvars

# Environment files
.env
.env.*
!.env.example

# Credentials and secrets
*.pem
*.key
*.p12
*.pfx
id_rsa*
credentials.json
service-account*.json

# Logs
*.log
logs/
*.log.*

# Temporary files
tmp/
temp/
*.tmp
*.bak

# Reports (may contain instance data)
*-report.txt
*-report-*.txt

# Security reports
security-reports/

# Test artifacts
coverage.out
coverage.html
*.test

# macOS
.DS_Store
.AppleDouble
.LSOverride

# Linux
*~
.directory

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini

# Compiled eBPF object — built by `make build-bpf` for embedding, never committed (#627)
internal/netbpf/*.bpf.o

# Local git worktrees (e.g. `git worktree add .worktrees/<name>`). These are
# separate checkouts living under the repo root; never commit them as embedded
# repos (a stray `git add -A` would otherwise sweep them in).
.worktrees/

# Benchmark host-specific config (real hostnames/IPs — see
# benchmark/*/README.md and CLAUDE.md's anonymization convention) and raw
# per-run logs. Reviewed summaries go in benchmark/*/RESULTS.md instead.
benchmark/*/config.env
benchmark/*/results/
