#!/bin/sh
# containarium managed-cluster autoscaler bootstrap (#1415).
# Stock cluster-autoscaler, digest-pinned, as a containerd task —
# outside the tenant-visible Kubernetes API surface.
set -eu

cat > /etc/systemd/system/k3s-cluster-autoscaler.service <<'UNIT'
[Unit]
Description=containarium managed-cluster autoscaler (externalgrpc)
After=k3s.service
Requires=k3s.service

[Service]
ExecStartPre=/usr/local/bin/k3s ctr images pull registry.k8s.io/autoscaling/cluster-autoscaler:v1.33.0@sha256:6ef10d108e0e45ecd883e074682330bbd4a3403e767ad56804800f2f4ee816da
ExecStartPre=-/usr/local/bin/k3s ctr task kill --signal SIGKILL cluster-autoscaler
ExecStartPre=-/usr/local/bin/k3s ctr container rm cluster-autoscaler
ExecStart=/usr/local/bin/k3s ctr run --rm --net-host --user 0 \
  --mount type=bind,src=/etc/containarium/ca,dst=/etc/containarium/ca,options=rbind:ro \
  --mount type=bind,src=/etc/rancher/k3s/k3s.yaml,dst=/etc/kubeconfig,options=rbind:ro \
  registry.k8s.io/autoscaling/cluster-autoscaler:v1.33.0@sha256:6ef10d108e0e45ecd883e074682330bbd4a3403e767ad56804800f2f4ee816da cluster-autoscaler \
  /cluster-autoscaler \
  --cloud-provider=externalgrpc \
  --cloud-config=/etc/containarium/ca/cloud-config.yaml \
  --kubeconfig=/etc/kubeconfig \
  --stderrthreshold=info
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
UNIT

systemctl daemon-reload
systemctl enable k3s-cluster-autoscaler.service

# Starting an already-enabled unit does not restart it, and the autoscaler reads its
# client credential once at start. Restart whenever the credential, the
# cloud-config or the unit changed since the last start, or the unit is not
# running, so a re-minted credential is the one actually presented (#3718).
fp=$(cat /etc/containarium/ca/client.crt /etc/containarium/ca/client.key /etc/containarium/ca/ca.crt /etc/containarium/ca/cloud-config.yaml /etc/systemd/system/k3s-cluster-autoscaler.service | sha256sum | cut -d' ' -f1)
if [ "$(cat /etc/containarium/ca-deployed.sha256 2>/dev/null || true)" = "$fp" ] && systemctl is-active --quiet k3s-cluster-autoscaler.service; then
  echo "autoscaler credential unchanged; leaving the unit running"
else
  systemctl restart k3s-cluster-autoscaler.service
  echo "$fp" > /etc/containarium/ca-deployed.sha256
fi
